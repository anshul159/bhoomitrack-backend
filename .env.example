MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/bhoomitrack?retryWrites=true&w=majority

# REQUIRED — server refuses to start without it. Use a long random string.
JWT_SECRET=change_this_to_a_long_random_string

# REQUIRED only for one-time super admin setup. Remove after setup if you like.
SETUP_KEY=change_this_setup_key

PORT=5000

# OPTIONAL — enables push notifications (new slip -> owner, approved/rejected -> manager).
# Base64-encode your Firebase service account JSON key so it survives as a single-line
# env var: `base64 -i serviceAccountKey.json | tr -d '\n'`. Without this set, push is a
# silent no-op — everything else keeps working (pull-to-refresh / dashboard polling still apply).
FIREBASE_SERVICE_ACCOUNT_BASE64=

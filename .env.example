# ─── Required ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/bhoomitrack
JWT_SECRET=generate-a-long-random-string-and-keep-it-secret

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# How long an access token lasts. Revocation is immediate regardless (ENH-012).
JWT_TTL=30d

# ─── Email — password reset (ENH-001) ────────────────────────────────────────
# Any SMTP provider: Resend, Amazon SES, Postmark, Brevo, Gmail.
# Without these, password reset cannot deliver a code and will fail in production.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=BhoomiTrack <no-reply@yourdomain.com>

# ─── Error tracking and uptime (ENH-004) ─────────────────────────────────────
# Leave blank to disable. Get a DSN from sentry.io (free tier is sufficient).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ─── Push notifications (ENH-021) ────────────────────────────────────────────
# base64 of the Firebase service-account JSON:  base64 -i service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ─── CORS (ENH-019) ──────────────────────────────────────────────────────────
# Comma-separated browser origins. The Android app sends no Origin and is always
# allowed; leave blank until a web client exists.
CORS_ORIGINS=

# ─── App version gate (ENH-010) ──────────────────────────────────────────────
# Builds below MIN_APP_VERSION get 426 and a blocking update screen.
# Leave at 0 to disable the gate.
MIN_APP_VERSION=0
LATEST_APP_VERSION=0
STORE_URL=https://play.google.com/store/apps/details?id=com.bhoomitrack

# ─── Subscription lifecycle (ENH-003) ────────────────────────────────────────
TRIAL_DAYS=30

# ─── Account deletion (ENH-013) ──────────────────────────────────────────────
DELETION_RETENTION_DAYS=30

# ─── One-time setup only ─────────────────────────────────────────────────────
# Enables POST /api/users/setup-super-admin. Leave unset in normal operation.
SETUP_KEY=

MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/bhoomitrack?retryWrites=true&w=majority

# REQUIRED — server refuses to start without it. Use a long random string.
JWT_SECRET=change_this_to_a_long_random_string

# REQUIRED only for one-time super admin setup. Remove after setup if you like.
SETUP_KEY=change_this_setup_key

PORT=5000
